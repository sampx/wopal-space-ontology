{
  "name": "@wopal/dsh-presets",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "WopalSpace agent preset bundles (wopal / fae / rook), hand-maintained, requires dsh >= 0.2.1-rc.5 (agentPreset delegation contract)",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "wopal",
    "fae",
    "rook"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "fae/preset.patch.yml",
        "rook/preset.patch.yml",
        "wopal/preset.patch.yml"
      ]
    }
  }
}
