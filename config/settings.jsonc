{
  "ellamaka": {
    "default_agent": "wopal",
    "autoupdate": true,
    "plugin": [
      [
        "file:///Volumes/U500G/coding/wopal-workspace/.wopal/plugins/dsh-adapter/index.ts",
        {
          "tools": [
            { "source": "grep", "target": "grep", "enable": true },
            { "source": "glob", "target": "glob", "enable": true },
            { "source": "read", "target": "read", "enable": true },
            { "source": "write", "target": "write", "enable": true },
            { "source": "edit", "target": "edit", "enable": true },
            {
              "source": "str_replace_editor",
              "target": "str_replace_editor",
              "enable": true
            },
            { "source": "bash", "target": "bash", "enable": true }
          ],
          "sandbox": { "enabled": true, "mode": "workspace-write" }
        }
      ]
    ],
    "permission": {
      "external_directory": {
        "*": "ask",
        "/tmp/**": "allow",
        "/var/folders/**": "allow"
      },
      "bash": {
        "rm -rf *": "ask",
        "trash *": "ask",
        "git reset *": "ask",
        "*/.tmp/*": "allow",
        "*/scripts/*": "allow",
        "* /tmp/*": "allow",
        "* /private/tmp/*": "allow",
        "*flow.sh *": "allow",
        "wopal *": "allow",
        "bash -n *": "allow"
      }
    }
    // "skills": {
    //   "paths": ["/Users/sam/coding/wopal/wopal-workspace/.agents/skills"]
    // },
  },
  "tui": {
    "plugin": [
      [
        "../plugins/tui-ellamaka.tsx",
        {
          "enabled": true,
          "label": "WOPALSPACE"
        }
      ]
    ],
    "attention": {
      "enabled": true,
      "notifications": true,
      "sound": true
    }
  }
}
