{
  "ellamaka": {
    "autoupdate": true,
    "permission": {
      "external_directory": {
        "*": "ask",
        "/tmp/**": "allow",
        "/var/folders/**": "allow"
      },
      "bash": {
        "rm -rf *": "ask",
        "trash *": "ask",
        "git reset *": "ask",
        "*/.tmp/*": "allow",
        "*/scripts/*": "allow",
        "* /tmp/*": "allow",
        "* /private/tmp/*": "allow",
        "*flow.sh *": "allow",
        "wopal *": "allow",
        "bash -n *": "allow"
      }
    }
  }
}
