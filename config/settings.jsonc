{
  "ellamaka": {
    "default_agent": "wopal",
    "autoupdate": true,
    // "server": {
    //   "cors": [
    //     "http://192.168.1.101:3000",
    //     "http://192.168.1.101:4097",
    //     "http://192.168.1.101:8888",
    //     "http://192.168.1.101:9999"
    //   ]
    // },
    "plugin": [
      [
        "file:///Volumes/U500G/coding/wopal-workspace/.wopal/plugins/dsh-adapter/index.ts",
        {
          "sandbox": { "enabled": true, "mode": "workspace-write" }
        }
      ]
    ],
    "permission": {
      "external_directory": {
        "*": "ask",
        "/tmp/**": "allow",
        "/var/folders/**": "allow"
      },
      "bash": {
        "rm -rf *": "ask",
        "trash *": "ask",
        "git reset *": "ask",
        "*/.tmp/*": "allow",
        "*/scripts/*": "allow",
        "* /tmp/*": "allow",
        "* /private/tmp/*": "allow",
        "*flow.sh *": "allow",
        "wopal *": "allow",
        "bash -n *": "allow"
      }
    }
    // "skills": {
    //   "paths": ["/Users/sam/coding/wopal/wopal-workspace/.agents/skills"]
    // },
  },
  "tui": {
    "plugin": [
      [
        "../plugins/tui-ellamaka.tsx",
        {
          "enabled": true,
          "label": "WOPALSPACE"
        }
      ]
    ],
    "attention": {
      "enabled": true,
      "notifications": true,
      "sound": true
    }
  }
}
