{
  "ellamaka": {
    "default_agent": "wopal",
    "autoupdate": true,
    "instructions": [
      ".wopal-space/STRUCTURE.md",
      ".wopal-space/REGULATIONS.md",
      ".wopal-space/memory/USER.md",
      ".wopal-space/memory/MEMORY.md"
    ],
    "plugin": [
      [
        "file:///Volumes/U500G/coding/wopal-workspace/.wopal/plugins/dsh-adapter/index.ts",
        {
          "sandbox": { "enabled": true, "mode": "workspace-write" }
        }
      ]
    ],
    "permission": {
      "external_directory": {
        "*": "ask",
        "/tmp/**": "allow",
        "/var/folders/**": "allow"
      },
      "bash": {
        "rm -rf *": "ask",
        "trash *": "ask",
        "git reset *": "ask",
        "*/.tmp/*": "allow",
        "*/scripts/*": "allow",
        "* /tmp/*": "allow",
        "* /private/tmp/*": "allow",
        "*flow.sh *": "allow",
        "wopal *": "allow",
        "bash -n *": "allow"
      }
    }
  },
  "tui": {
    "plugin": [
      [
        "../plugins/tui-ellamaka.tsx",
        {
          "enabled": true,
          "label": "WOPALSPACE"
        }
      ]
    ],
    "attention": {
      "enabled": true,
      "notifications": true,
      "sound": true
    }
  }
}
